# M365 Multi-Tenant Admin - Environment Configuration Template
# 复制此文件为 .env 并填入实际值

# 应用配置
DEBUG=false

# 安全密钥（必须更改为强随机字符串）
SECRET_KEY=change-this-to-a-strong-random-string

# Tenant 凭据加密密钥（Fernet key）
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_SECRET_ENCRYPTION_KEY=change-this-generate-fernet-key

# CORS 配置
# 生产环境设置为实际域名，多个域名用逗号分隔
CORS_ORIGINS=https://your-domain.com

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./data/m365_admin.db

# 端口配置
PORT=5173
